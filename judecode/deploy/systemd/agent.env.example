# Install as /etc/judecode/agent.env, root:root 0600. Never commit real keys.
JUDECODE_PROVIDER=openrouter
JUDECODE_OPENROUTER_MODEL=qwen/qwen3.7-flash
JUDECODE_OPENROUTER_API_KEY=
JUDECODE_EXPERT_ENABLED=0
JUDECODE_AUTONOMOUS_MAX_BUDGET=1
JUDECODE_VAULT=/var/lib/judecode/.judecode/vault
JUDECODE_PERM_READ=auto
JUDECODE_PERM_WRITE=auto
JUDECODE_PERM_SHELL=ask
JUDECODE_PERM_DELETE=deny
JUDECODE_PERM_DEPLOY=deny
JUDECODE_PERM_SYSTEM=deny
JUDECODE_PERM_NETWORK=ask
