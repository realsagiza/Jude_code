# Jude Code Configuration Template

# ── Tavily Search API (AI-powered web search, แทน DuckDuckGo) ──
# ลงทะเบียนฟรีได้ที่ https://tavily.com
# ถ้าไม่ตั้งค่าไว้ จะใช้ DuckDuckGo fallback แทน
TAVILY_API_KEY=

# ── Provider Selection ──
# Choose your AI provider: "deepseek" (default), "anthropic", or "zai" (GLM)
JUDECODE_PROVIDER=deepseek

# ── DeepSeek API (OpenAI-compatible) ──
# ใช้ DeepSeek Cloud API โดยตรง
# ⚠️ ต้องตั้งค่า JUDECODE_DEEPSEEK_API_KEY ก่อนใช้งาน
JUDECODE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
JUDECODE_DEEPSEEK_BASE_URL=https://api.deepseek.com
JUDECODE_DEEPSEEK_MODEL=deepseek-chat

# ── Anthropic API (Claude) ──
# ใช้ Anthropic Messages API โดยตรง (native protocol)
# ⚠️ ต้องตั้งค่า JUDECODE_ANTHROPIC_API_KEY ก่อนใช้งาน
JUDECODE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
JUDECODE_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Z.AI / Zhipu GLM API (OpenAI-compatible) ──
# ใช้ GLM models (glm-4.6 ฯลฯ) ผ่าน OpenAI-compatible endpoint
# ตั้ง JUDECODE_PROVIDER=zai เพื่อใช้งาน
# ⚠️ ต้องตั้งค่า JUDECODE_ZAI_API_KEY ก่อนใช้งาน
# General endpoint:  https://api.z.ai/api/paas/v4
# GLM Coding Plan:   https://api.z.ai/api/coding/paas/v4
JUDECODE_ZAI_API_KEY=your_zai_api_key_here
JUDECODE_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
JUDECODE_ZAI_MODEL=glm-4.6

# ── Vision API (Screenshot Analysis) ──
# รองรับ Cloud API เช่น DashScope/Qwen, OpenAI Vision
# ⚠️ ต้องตั้งค่าทั้ง 3 ตัวแปร ไม่มี default fallback
# ⚠️ Set your API key here - do NOT hardcode in source code!
#
# Example with DashScope (Alibaba Cloud Qwen):
#   JUDECODE_VISION_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   JUDECODE_VISION_API_KEY=sk-your-dashscope-key-here
#   JUDECODE_VISION_MODEL=qwen-vl-max
#
# Example with OpenAI:
#   JUDECODE_VISION_BASE_URL=https://api.openai.com/v1
#   JUDECODE_VISION_API_KEY=sk-your-openai-key-here
#   JUDECODE_VISION_MODEL=gpt-4o-mini
JUDECODE_VISION_BASE_URL=
JUDECODE_VISION_API_KEY=
JUDECODE_VISION_MODEL=

# ── Telegram Bot (Optional) ──
# คุยกับ Jude Code ผ่าน Telegram
# 1. สร้าง bot กับ @BotFather แล้วเอา token มาใส่
# 2. หา Telegram User ID ของคุณจาก @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_MAX_MESSAGE_LENGTH=4000

# ── Other Settings ──
JUDECODE_MAX_TOKENS=8192
JUDECODE_TEMPERATURE=0.7
JUDECODE_MAX_CONTINUATIONS=100
# JUDECODE_VAULT=/path/to/your/vault
